# ==============================================================================
# TECTONIC NG — ESCROW & DIGITAL CONTRACTS CONFIGURATION
# Engine: Documenso (Next.js + Prisma + PostgreSQL + Cryptographic Signing)
# ==============================================================================

# --- Application Core ---
NODE_ENV=production
NEXTAUTH_URL="https://contracts.clientdomain.com"
NEXTAUTH_SECRET="generate-secure-random-64-char-string-here"
ENCRYPTION_SECONDARY_KEY="generate-secure-random-32-char-string-here"

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/documenso_contracts?sslmode=prefer"

# --- S3 Compatible Storage for Signed PDFs ---
# AWS S3, Cloudflare R2, or MinIO
NEXT_PUBLIC_UPLOAD_TRANSPORT="s3"
NEXT_PRIVATE_UPLOAD_ENDPOINT="https://s3.af-south-1.amazonaws.com"
NEXT_PRIVATE_UPLOAD_BUCKET="tectonic-signed-contracts"
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="your_aws_key_id"
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="your_aws_secret_key"

# --- Cryptographic Audit & Timestamp Authority ---
TIMESTAMP_AUTHORITY_URL="http://timestamp.digicert.com"
LEGAL_JURISDICTION="Federal Republic of Nigeria (Evidence Act 2011 / NDPR)"

# --- WhatsApp Signature Links (Termii / Meta) ---
TERMII_API_KEY="TL_your_termii_api_key_here"
NOTIFY_ON_SIGNATURE_COMPLETE="+2348000000000"
